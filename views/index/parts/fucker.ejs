<mdui-card variant="elevated" class="grid-card" style="margin-bottom: 0.75rem;">
  <div style="display: flex;align-items: center;margin-bottom: 1rem;">
    <mdui-icon name="list_alt" style="font-size: 2rem;margin-right: 1rem;"></mdui-icon>
    <div style="font-size: x-large;font-weight: bold;">Target</div>
  </div>
  <div style="margin-bottom: 1rem;opacity: 0.75;">在此处管理抢课目标课程。</div>
  <div style="display: flex;flex-wrap: wrap;gap: 0.75rem;align-items: center;margin-bottom: 1rem;">
    <mdui-select id="input-target-mode" style="width: 10rem;" value="normal">
      <mdui-menu-item value="normal">抢课</mdui-menu-item>
      <mdui-menu-item value="swap">换课</mdui-menu-item>
      <mdui-menu-item value="pickup">捡漏</mdui-menu-item>
    </mdui-select>
    <mdui-text-field id="input-target-code" style="width: 22rem;max-width: 100%;" clearable></mdui-text-field>
    <mdui-text-field id="input-swap-source" style="width: 22rem;max-width: 100%;" clearable hidden></mdui-text-field>
    <mdui-button onclick="buttonTargetAdd()">添加</mdui-button>
    <span id="courses-index-status" style="opacity: 0.55;font-size: 0.85rem;">课程库加载中...</span>
  </div>

  <script>
    document.getElementById("input-target-mode").addEventListener("change", function () {
      const normal = this.value === 'normal'
      const swap = this.value === 'swap'
      const pickup = this.value === 'pickup'
      const field1 = document.getElementById("input-target-code")
      const field2 = document.getElementById("input-swap-source")
      if (normal) {
        field1.label = "目标选课序号 (cttId)"
        field1.help = "输入要抢的教学班序号"
        field1.hidden = false
        field2.hidden = true
      } else if (swap) {
        field1.label = "目标选课序号 (cttId)"
        field1.help = "要换过去的目标教学班"
        field1.hidden = false
        field2.label = "当前已选选课序号 (cttId)"
        field2.help = "你当前已在这门课的哪个教学班"
        field2.hidden = false
      } else if (pickup) {
        field1.label = "选课序号 (cttId)"
        field1.help = "输入该课程任意一个教学班序号，自动收集该课程所有班次"
        field1.hidden = false
        field2.hidden = true
      }
    })
    // 初始触发以设置默认 label
    setTimeout(() => document.getElementById("input-target-mode").dispatchEvent(new Event("change")), 100)
  </script>


  <table class="mdui-table" style="margin: 0;">
    <thead>
      <tr>
        <th>选课序号</th>
        <th>模式</th>
        <th>课程名称</th>
        <th>最大/申请/已录</th>
        <th>任课教师</th>
        <th>上课周次</th>
        <th>上课时间</th>
        <th>上课地点</th>
        <th>信息</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="target-tbody">

    </tbody>

  </table>

  <mdui-button fullwidth style="margin-top: 1rem;margin-right: 0.5rem;" onClick="targetDeleteAll()">删除所有课程
    <mdui-icon slot="icon" name="delete"></mdui-icon>
  </mdui-button>

  <mdui-button variant="outlined" fullwidth style="margin-top: 1rem" onclick="generateCli()">
    生成 DLSF-CLI 脚本
  </mdui-button>
</mdui-card>

<div class="grid-container" id="container-worker">

  <mdui-card variant="elevated" class="grid-card">
    <div style="display: flex;align-items: center;margin-bottom: 1rem;">
      <mdui-icon name="settings" style="font-size: 2rem;margin-right: 1rem;"></mdui-icon>
      <div style="font-size: x-large;font-weight: bold;">Settings</div>
    </div>
    <div style="margin-bottom: 1rem;opacity: 0.75;">在此处修改脚本配置。</div>

    <div style="display: flex;align-items: center;">
      <div style="white-space: nowrap;">间隔调节</div>
      <mdui-slider id="slider-main-speed" tickmarks value="3" step="1" min="1" max="15"
        oninput="interval=this.value*1000"></mdui-slider>
      <script>
        const slider = document.getElementById("slider-main-speed")
        slider.labelFormatter = (value) => `${value} 秒`
      </script>
    </div>
    <div style="opacity: 0.5;">选课执行的间隔时间。</div>

    <div style="display: flex;align-items: center;margin-top: 1rem;">
      <mdui-switch id="switch-checkiffull" onchange="alertSwitchCheckIfFull(this)"></mdui-switch>
      &nbsp;&nbsp;&nbsp;
      <div>不校验人数</div>
    </div>
    <div style="opacity: 0.5;">在选课之前不校验人数，适用于选课高峰期人数无法快速获取的情况。</div>

    <div style="display: flex;align-items: center;margin-top: 1rem;">
      <mdui-switch id="switch-lowspeed" onchange="switchLowSpeed(this)"></mdui-switch>
      &nbsp;&nbsp;&nbsp;
      <div>低速模式</div>
    </div>
    <div style="opacity: 0.5;">允许使用更长的间隔进行抢课，适用于选课高峰期网络状况不佳的情况。</div>

  </mdui-card>



  <mdui-card variant="elevated" class="grid-card">
    <div style="display: flex;align-items: center;margin-bottom: 1rem;">
      <mdui-icon name="terminal" style="font-size: 2rem;margin-right: 1rem;"></mdui-icon>
      <div style="font-size: x-large;font-weight: bold;">Console</div>
    </div>
    <div style="margin-bottom: 1rem;opacity: 0.75;">确认目标课程与 Token 正确后，用下面的按钮切换抢课脚本开关。</div>

    <div id="switch-main-status" style="display: flex;align-items: center;opacity: 0.75;">
      <mdui-switch id="switch-main" onchange="switchMain()"></mdui-switch>
      &nbsp;&nbsp;&nbsp;
      <mdui-badge style="background-color: lightcoral;"></mdui-badge>
      &nbsp;
      <div>脚本已停止</div>
    </div>
  </mdui-card>


</div>
